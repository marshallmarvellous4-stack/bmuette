# Copy to apps/api/.env for local runs without Docker. In production set these in your host's secret manager.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://bmuette:bmuette@localhost:5432/bmuette
REDIS_URL=redis://localhost:6379          # optional; without it a small in-memory cache is used

# Long random string, at least 32 characters:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
#PUBLIC_BASE_URL=http://localhost:3000  
PUBLIC_BASE_URL=http://192.168.36.48:3000   # the public https:// address of this API in production

# Images. "local" is for development only. Use "s3" for Cloudflare R2, AWS S3 or MinIO.
STORAGE_DRIVER=local
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=bmuette-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://media.yourdomain.com

# Video. "local" is for development only. Use "cloudflare" (Cloudflare Stream) in production.
VIDEO_DRIVER=local
# CF_ACCOUNT_ID=
# CF_STREAM_API_TOKEN=
# CF_STREAM_CUSTOMER_CODE=
# CF_STREAM_WEBHOOK_SECRET=

# Payments (test keys first!)
PLATFORM_FEE_BPS=500                      # 500 = 5% platform fee
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# FLW_SECRET_KEY=FLWSECK_TEST-...
# FLW_WEBHOOK_HASH=                       # the "secret hash" you set in the Flutterwave dashboard
CHECKOUT_RETURN_URL=bmuette://checkout

# Visual + meaning search (the Python service in apps/ai)
# AI_SERVICE_URL=http://localhost:8000

# log = only log, expo = real phone notifications (needs a dev/production build, not Expo Go)
PUSH_DRIVER=log
# days a sale is held before the shop can take it out
PAYOUT_HOLD_DAYS=7
# days after delivery that a buyer can return an item
RETURN_WINDOW_DAYS=14
